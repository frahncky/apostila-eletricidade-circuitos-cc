% =====================================================================
%  NIVEL DE DIFICULDADE
% =====================================================================
\newcommand{\estrelacheia}{%
  \tikz[baseline=-0.35ex]\node[star,star points=5,star point ratio=2.3,
    fill=laranja,draw=laranja,inner sep=1.15pt]{};}
\newcommand{\estrelavazia}{%
  \tikz[baseline=-0.35ex]\node[star,star points=5,star point ratio=2.3,
    fill=white,draw=laranja!55,line width=0.35pt,inner sep=1.15pt]{};}

\newcommand{\nivelmarca}[1]{%
  \ifcase#1\relax
    \or \estrelacheia\estrelavazia\estrelavazia\estrelavazia
    \or \estrelacheia\estrelacheia\estrelavazia\estrelavazia
    \or \estrelacheia\estrelacheia\estrelacheia\estrelavazia
    \or \estrelacheia\estrelacheia\estrelacheia\estrelacheia
  \fi}

% legenda dos niveis (para a abertura do capitulo)
\newcommand{\legendaniveis}{%

% =====================================================================
%  AMBIENTE DE QUESTAO
%  \begin{questao}[nivel][fonte]  ... \end{questao}
% =====================================================================
\newcounter{questao}
\renewcommand{\thequestao}{\arabic{questao}}

\newcommand{\selodaquestao}[2]{%
  \tikz[baseline=(txt.base)]{
    \node[draw=azulprof,fill=azulclaro,rounded corners=2.5pt,
          inner xsep=5pt,inner ysep=2.2pt,line width=0.5pt]
         (txt) {\sffamily\bfseries\small\color{azulprof}#1};}%
  \hspace{4pt}\nivelmarca{#2}%
  \ifstrempty{\questaofonte}{}{\hspace{4pt}{\footnotesize\sffamily\color{cinza}(\questaofonte)}}%
}

\newcommand{\questaofonte}{}
\newenvironment{questao}[2][1]{%
  \renewcommand{\questaofonte}{#2}%
  \par\addvspace{1.15em}\penalty-100%
  \refstepcounter{questao}%
  \begin{list}{}{%
     \setlength{\leftmargin}{2.9em}%
     \setlength{\itemindent}{-2.9em}%
     \setlength{\labelwidth}{0pt}\setlength{\labelsep}{0pt}%
     \setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}%
     \setlength{\parsep}{0.45em}\setlength{\itemsep}{0pt}}%
  \item\selodaquestao{\thequestao}{#1}\hspace{0.55em}\ignorespaces
}{%
  \end{list}\par\addvspace{0.2em}%
}

% ------------------------- alternativas ------------------------------
% \begin{alternativas}        -> 1 coluna
% \begin{alternativas}[2]     -> 2 colunas   (use para itens curtos)
\newenvironment{alternativas}[1][1]{%
  \def\@altcols{#1}%
  \ifnum#1>1\relax
    \setlength{\multicolsep}{4pt}%
    \begin{multicols}{#1}\raggedcolumns
  \fi
  \begin{enumerate}[label=\textbf{\alph*)},leftmargin=1.9em,
      itemsep=0.25em,parsep=0pt,topsep=0.35em,partopsep=0pt]
}{%
  \end{enumerate}%
  \ifnum\@altcols>1\relax\end{multicols}\fi
}

% subitens (a), b), ...) de questoes discursivas
\newenvironment{itensq}{%
  \begin{enumerate}[label=\textbf{\alph*)},leftmargin=1.9em,
      itemsep=0.3em,parsep=0pt,topsep=0.35em]}{\end{enumerate}}


% figura padrao (conteudo, legenda, rotulo)
\newcommand{\figuraq}[3]{%
  \begin{figure}[H]\centering #1 \caption{#2}\label{#3}\end{figure}}

% circuito da questao corrente, com legenda e rotulo automaticos
\newcommand{\circuitoq}[1]{%
  \begin{figure}[H]\centering #1
   \caption{Circuito da questão \thequestao.}\label{fig:q\thequestao}\end{figure}}

% mesmo, com legenda personalizada
\newcommand{\circuitoqq}[2]{%
  \begin{figure}[H]\centering #1
   \caption{#2}\label{fig:q\thequestao}\end{figure}}

% item de circuito dentro de uma grade a) b) c) d)
\newcommand{\subcirc}[2]{%
  \begin{minipage}[t]{0.48\linewidth}\centering
    \textbf{\sffamily #1)}\\[0.4em] #2
  \end{minipage}}

% =====================================================================
%  GABARITO AUTOMATICO
% =====================================================================
\newcommand{\ChaveLista}{}
\newcommand{\ResolLista}{}
\newif\ifhaveresol \haveresolfalse

\newcommand{\resposta}[1]{%
  \begingroup
  \edef\x{\endgroup
    \noexpand\gappto\noexpand\ChaveLista{%
       \noexpand\chaveitem{\arabic{questao}}{\unexpanded{#1}}}%
    \noexpand\gappto\noexpand\ResolLista{%
       \noexpand\resolhead{\arabic{questao}}{\unexpanded{#1}}}%
  }\x}

\newcommand{\resolucao}[1]{%
  \global\haveresoltrue
  \begingroup
  \edef\x{\endgroup
    \noexpand\gappto\noexpand\ResolLista{\noexpand\resolbody{\unexpanded{#1}}}%
  }\x}

% --- renderizacao dos itens ------------------------------------------
\newcommand{\chaveitem}[2]{%
  \par\noindent\makebox[2.1em][l]{\bfseries\sffamily\color{verdeq}#1.}#2\par}

\newcommand{\resolhead}[2]{%
  \par\addvspace{0.9em}\noindent
  \tikz[baseline=(t.base)]{\node[fill=verdeq,text=white,rounded corners=2pt,
     inner xsep=5pt,inner ysep=2pt] (t)
     {\sffamily\bfseries\small #1};}\hspace{5pt}%
  \textbf{\sffamily\small #2}\par\nobreak\vspace{0.15em}}

\newcommand{\resolbody}[1]{\par\noindent\small #1\par}

% --- comando de impressao --------------------------------------------
\newcommand{\gabaritotitulo}{Gabarito}
\newcommand{\gabarito}[1][]{%
  \par\addvspace{1.6em}
  \noindent{\color{verdeq}\rule{\linewidth}{1.2pt}}\par\vspace{2pt}
  \noindent{\sffamily\bfseries\large\color{verdeq}\gabaritotitulo
    \ifstrempty{#1}{}{ \textmd{---} \textmd{#1}}}\par
  \noindent{\color{verdeq}\rule{\linewidth}{0.5pt}}\par\vspace{0.7em}
  \addcontentsline{toc}{subsection}{Gabarito\ifstrempty{#1}{}{ --- #1}}%
  {\sffamily\small\color{cinza}Chave de respostas}\par\vspace{0.35em}
  \begin{multicols}{3}\small\raggedcolumns
    \ChaveLista
  \end{multicols}
  \ifhaveresol
    \vspace{0.6em}
    {\sffamily\small\color{cinza}Resoluções comentadas}\par
    \ResolLista
  \fi
  \gdef\ChaveLista{}\gdef\ResolLista{}\global\haveresolfalse
  \par\addvspace{1em}}

\endinput

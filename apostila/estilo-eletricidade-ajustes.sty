\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo-eletricidade-ajustes}[2026/08/18 v1.3 Ajustes visuais]

% Deve ser carregado depois de estilo-eletricidade.
\RequirePackage{adjustbox}

% Padrao unico para fontes independentes de tensao:
% circulo com polaridade (+/-) no interior.
% Os aliases corrigem automaticamente desenhos antigos que ainda utilizam
% simbolos de bateria/celula do CircuitikZ.
\tikzset{
  battery/.style={american voltage source},
  battery1/.style={american voltage source},
  battery2/.style={american voltage source}
}

% Evita que circuitos largos ultrapassem a largura util da pagina.
% O conteudo so e reduzido quando realmente necessario.
\renewcommand{\circuitoq}[1]{%
  \begin{figure}[H]\centering
  \begin{adjustbox}{max width=.96\linewidth}
    #1
  \end{adjustbox}%
  \caption{Circuito da questão \thequestao.}\label{fig:q\thequestao}%
  \end{figure}}

\renewcommand{\circuitoqq}[2]{%
  \begin{figure}[H]\centering
  \begin{adjustbox}{max width=.96\linewidth}
    #1
  \end{adjustbox}%
  \caption{#2}\label{fig:q\thequestao}%
  \end{figure}}

% Nas questoes 355 e 404 existem quatro subcircuitos (a)--(d).
% Para dar maior destaque aos desenhos, cada subcircuito ocupa praticamente
% meia largura util. Assim, cabem exatamente dois por linha: (a,b) e (c,d).
% O resizebox faz o circuito preencher a sua meia pagina, em vez de permanecer
% pequeno por causa do scale local do CircuitikZ.
\renewcommand{\subcirc}[2]{%
  \ifnum\value{questao}=355\relax
    \begin{minipage}[t]{0.49\linewidth}\centering
      \textbf{\sffamily #1)}\\[0.45em]
      \resizebox{0.96\linewidth}{!}{#2}%
    \end{minipage}%
  \else\ifnum\value{questao}=404\relax
    \begin{minipage}[t]{0.49\linewidth}\centering
      \textbf{\sffamily #1)}\\[0.45em]
      \resizebox{0.96\linewidth}{!}{#2}%
    \end{minipage}%
  \else
    \begin{minipage}[t]{0.48\linewidth}\centering
      \textbf{\sffamily #1)}\\[0.4em] #2
    \end{minipage}%
  \fi\fi}

% Macros de desenhos que substituem apenas circuitos identificados na
% auditoria visual como sobrepostos ou excessivamente comprimidos.
\InputIfFileExists{bancos/circuitos-revisados-analise.tex}{}{}

\endinput

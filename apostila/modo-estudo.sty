% =====================================================================
%  modo-estudo.sty
%  Saidas especializadas da apostila:
%    - questoes: enunciados + gabarito, sem resolucoes
%    - resolucoes: somente resolucoes comentadas
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{modo-estudo}[2026/08/17 v1.0 Modos de estudo]

\newif\ifmodoquestoes
\newif\ifmodoresolucoes
\modoquestoesfalse
\modoresolucoesfalse

\DeclareOption{questoes}{\modoquestoestrue}
\DeclareOption{resolucoes}{\modoresolucoestrue}
\ProcessOptions\relax

\ifmodoquestoes
  % Acumula somente a chave curta de respostas.
  \renewcommand{\resposta}[1]{%
    \begingroup
    \edef\x{\endgroup
      \noexpand\gappto\noexpand\ChaveLista{%
        \noexpand\chaveitem{\arabic{questao}}{\unexpanded{#1}}}%
    }\x}

  % Por seguranca: se alguma resolucao escapar do gerador, nao aparece.
  \renewcommand{\resolucao}[1]{}

  \renewcommand{\gabarito}[1][]{%
    \par\addvspace{1.6em}
    \noindent{\color{verdeq}\rule{\linewidth}{1.2pt}}\par\vspace{2pt}
    \noindent{\sffamily\bfseries\large\color{verdeq}Gabarito
      \ifstrempty{#1}{}{ \textmd{---} \textmd{#1}}}\par
    \noindent{\color{verdeq}\rule{\linewidth}{0.5pt}}\par\vspace{0.7em}
    \addcontentsline{toc}{subsection}{Gabarito\ifstrempty{#1}{}{ --- #1}}%
    \begin{multicols}{3}\small\raggedcolumns
      \ChaveLista
    \end{multicols}
    \gdef\ChaveLista{}\gdef\ResolLista{}\global\haveresolfalse
    \par\addvspace{1em}}
\fi

\ifmodoresolucoes
  % Cada resposta abre a resolucao com o numero original da questao.
  \renewcommand{\resposta}[1]{%
    \begingroup
    \edef\x{\endgroup
      \noexpand\gappto\noexpand\ResolLista{%
        \noexpand\resolhead{\arabic{questao}}{\unexpanded{#1}}}%
    }\x}

  \renewcommand{\resolucao}[1]{%
    \global\haveresoltrue
    \begingroup
    \edef\x{\endgroup
      \noexpand\gappto\noexpand\ResolLista{%
        \noexpand\resolbody{\unexpanded{#1}}}%
    }\x}

  \renewcommand{\gabarito}[1][]{%
    \ifstrempty{\ResolLista}{}{%
      \par\addvspace{1.6em}
      \noindent{\color{verdeq}\rule{\linewidth}{1.2pt}}\par\vspace{2pt}
      \noindent{\sffamily\bfseries\large\color{verdeq}Resolucoes comentadas
        \ifstrempty{#1}{}{ \textmd{---} \textmd{#1}}}\par
      \noindent{\color{verdeq}\rule{\linewidth}{0.5pt}}\par\vspace{0.7em}
      \addcontentsline{toc}{subsection}{Resolucoes\ifstrempty{#1}{}{ --- #1}}%
      \ResolLista
      \par\addvspace{1em}}%
    \gdef\ChaveLista{}\gdef\ResolLista{}\global\haveresolfalse}
\fi

\ifmodoquestoes\else
  \ifmodoresolucoes\else
    \PackageError{modo-estudo}{Selecione questoes ou resolucoes}%
      {Use \string\usepackage[questoes]{modo-estudo} ou
       \string\usepackage[resolucoes]{modo-estudo}.}
  \fi
\fi

\endinput
